---
import Base from "../layouts/Base.astro";
import { book, chapters } from "../data/chapters.js";
import { translatedChapters } from "../lib/book.js";

const base = import.meta.env.BASE_URL;
const slugSet = new Set(chapters.map((c) => c.slug));
const done = new Set(translatedChapters().map((c) => c.slug));
void slugSet;
---

<Base>
  <main class="cover">
    <p class="kicker">{book.series}</p>
    <h1>{book.title}</h1>
    <p class="sub">{book.subtitle}</p>
    <p class="en-title">{book.titleEn}</p>
    <p class="byline">
      {book.author}
      <small>{book.authorEn} · {book.year}</small>
    </p>

    <ol class="toc">
      {
        chapters.map((c) => (
          <li>
            {done.has(c.slug) ? (
              <a href={`${base}${c.slug}/`}>
                <span class="num">{c.num}</span>
                <span class="label">{c.title}</span>
              </a>
            ) : (
              <span class="pending">
                <span class="num">{c.num}</span>
                <span class="label">{c.title}</span>
                <span class="state">待译</span>
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <p class="note">
      中文译文由机器翻译完成，供学习与阅读参考，与原著出版方无关。原文版权归 Patrick D. Wall 与哥伦比亚大学出版社所有。
    </p>
  </main>
</Base>
