---
import Base from "../layouts/Base.astro";
import { book, chapters } from "../data/chapters.js";
import { loadChapter, translatedChapters } from "../lib/book.js";

export function getStaticPaths() {
  return translatedChapters().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const { meta, blocks } = loadChapter(slug);
const base = import.meta.env.BASE_URL;
const i = chapters.findIndex((c) => c.slug === slug);
const prev = chapters[i - 1];
const next = chapters[i + 1];
const doneSet = new Set(translatedChapters().map((c) => c.slug));

const label = meta.slug === "preface" || meta.slug === "epilogue" ? "" : `第 ${meta.num} 章`;
---

<Base>
  <header class="bar">
    <button id="open-toc" type="button">目录</button>
    <span class="bar-title">{meta.title}</span>
    <button id="open-settings" type="button">设置</button>
  </header>

  <main data-slug={meta.slug} data-title={meta.title} data-num={meta.num}>
    <div id="resume" class="resume" hidden></div>
    {label && <p class="kicker">{label}</p>}
    <h1>{meta.title}</h1>
    <p class="orig-title">{meta.titleEn}</p>

    <article>
      {
        blocks.map((b, idx) => {
          const figs = b.images.length ? (
            <figure>
              {b.images.map((src) => (
                <img src={`${base}figures/${src}`} alt="" loading="lazy" />
              ))}
            </figure>
          ) : null;

          if (b.type === "h2") {
            return (
              <>
                <h2 id={`b-${idx}`} data-anchor={idx}>
                  {b.zh ?? b.en}
                  {b.zh && <span class="en">{b.en}</span>}
                </h2>
                {figs}
              </>
            );
          }

          if (b.type === "figcap") {
            return (
              <>
                {figs}
                <p id={`b-${idx}`} class="block figcap" data-anchor={idx}>
                  {b.zh ?? b.en}
                  {b.zh && <span class="en">{b.en}</span>}
                </p>
              </>
            );
          }

          return (
            <>
              <div id={`b-${idx}`} class="block" data-anchor={idx}>
                <p class={b.zh ? "zh" : "standalone-en"} lang={b.zh ? "zh-CN" : "en"}>
                  {b.zh ?? b.en}
                </p>
                {b.zh && <p class="en" lang="en">{b.en}</p>}
              </div>
              {figs}
            </>
          );
        })
      }
    </article>

    <nav class="pager">
      {
        prev && doneSet.has(prev.slug) && (
          <a href={`${base}${prev.slug}/`}>
            <span class="dir">上一章</span>
            {prev.title}
          </a>
        )
      }
      {
        next && doneSet.has(next.slug) && (
          <a class="next" href={`${base}${next.slug}/`}>
            <span class="dir">下一章</span>
            {next.title}
          </a>
        )
      }
    </nav>
  </main>

  <dialog id="toc" class="drawer">
    <div class="drawer-head">
      <span class="drawer-title">{book.title}</span>
      <button type="button" class="sheet-close" data-close aria-label="关闭">×</button>
    </div>
    <ol class="drawer-list">
      {
        chapters.map((c) => (
          <li data-slug={c.slug} class:list={["toc-item", c.slug === slug && "current"]}>
            <a href={`${base}${c.slug}/`}>
              <span class="num">{c.num}</span>
              <span class="label">{c.title}</span>
              <span class="pct" />
            </a>
          </li>
        ))
      }
    </ol>
  </dialog>

  <dialog id="settings" class="sheet">
    <div class="sheet-head">
      <h2>阅读设置</h2>
      <button type="button" class="sheet-close" data-close aria-label="关闭">×</button>
    </div>

    <p class="sheet-label">字号</p>
    <div class="seg" id="font-seg">
      <button type="button" data-font="0">中</button>
      <button type="button" data-font="1">大</button>
      <button type="button" data-font="2">特大</button>
    </div>

    <label class="sheet-row">
      <span>显示英文原文</span>
      <input type="checkbox" id="show-en" />
      <span class="switch" aria-hidden="true"></span>
    </label>
  </dialog>

  <script>
    import "../scripts/chapter-progress.js";
    import { initSettings } from "../scripts/settings.js";
    import { initToc } from "../scripts/toc.js";

    initSettings();
    initToc();
  </script>
</Base>
